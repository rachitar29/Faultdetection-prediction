
"""Row-wise batch prediction for uploaded industrial sensor datasets.

Uses the registered XGBoost model's fitted numeric imputer and the
existing integrated prediction engine. Does not modify model artifacts.
"""

import argparse
import json
import math
from datetime import datetime
from pathlib import Path

import joblib
import numpy as np
import pandas as pd

from app.ml.datasets.compatibility_checker import (
    DEFAULT_MODEL_PATH,
    DEFAULT_METADATA_PATH,
    NUMERIC_FEATURES,
    check_dataset_compatibility,
)
from app.ml.ingestion.column_mapper import map_sensor_columns
from app.ml.ingestion.file_loader import load_machine_data
from app.ml.maintenance.integrated_engine import (
    predict_equipment_condition,
)


BACKEND_ROOT = Path(__file__).resolve().parents[3]
DEFAULT_OUTPUT_DIR = (
    BACKEND_ROOT / "ml_artifacts" / "reports" / "batch_predictions"
)

REQUIRED_FEATURES = [
    "Air temperature [K]",
    "Process temperature [K]",
    "Rotational speed [rpm]",
    "Torque [Nm]",
    "Tool wear [min]",
    "Type",
]

VALID_MACHINE_TYPES = {"L", "M", "H"}
MAX_BATCH_ROWS = 50000

REJECTION_COLUMNS = [
    "row_number",
    "processing_status",
    "rejection_stage",
    "rejection_reason",
]


def _is_missing(value):
    """Return True for actual missing values and blank strings."""
    if value is None:
        return True

    if isinstance(value, str) and not value.strip():
        return True

    try:
        return bool(pd.isna(value))
    except (TypeError, ValueError):
        return False


def _is_explicit_true(value):
    """Accept only actual Boolean true values."""
    return isinstance(value, (bool, np.bool_)) and bool(value)


def _build_rejected_record(
    source_record,
    row_number,
    reason,
    processing_status,
    rejection_stage,
):
    """Build a rejected-row record with a consistent output schema."""
    rejected = dict(source_record)

    rejected["row_number"] = row_number
    rejected["processing_status"] = processing_status
    rejected["rejection_stage"] = rejection_stage
    rejected["rejection_reason"] = str(reason)

    return rejected


def _empty_rejected_dataframe(original):
    """Return an empty rejected-row DataFrame with stable columns."""
    columns = list(original.columns)

    for column in REJECTION_COLUMNS:
        if column not in columns:
            columns.append(column)

    if "rejection_reason" not in columns:
        columns.append("rejection_reason")

    return pd.DataFrame(columns=columns)


def _load_model():
    """Load the registered classifier without changing its artifacts."""
    model_path = Path(DEFAULT_MODEL_PATH)
    metadata_path = Path(DEFAULT_METADATA_PATH)

    if not model_path.is_file():
        raise FileNotFoundError(
            f"Registered model not found: {model_path}"
        )

    if not metadata_path.is_file():
        raise FileNotFoundError(
            f"Model metadata not found: {metadata_path}"
        )

    model = joblib.load(model_path)

    with metadata_path.open("r", encoding="utf-8") as file:
        metadata = json.load(file)

    if not isinstance(metadata, dict):
        raise ValueError("Model metadata must contain a JSON object.")

    if not hasattr(model, "named_steps"):
        raise ValueError(
            "Registered model is not the expected fitted pipeline."
        )

    metadata_features = metadata.get("feature_names", [])
    model_features = list(
        getattr(model, "feature_names_in_", [])
    )

    if not metadata_features or metadata_features != model_features:
        raise ValueError(
            "Registered model feature names do not match metadata."
        )

    return model, metadata


def _get_fitted_numeric_imputer(model):
    """Find the already-fitted numeric imputer inside the pipeline."""
    try:
        preprocessor = model.named_steps["preprocessor"]
        numeric_transformer = (
            preprocessor.named_transformers_["numeric"]
        )
    except (KeyError, AttributeError, TypeError) as exc:
        raise ValueError(
            "Could not locate the fitted numeric preprocessing pipeline."
        ) from exc

    candidates = [numeric_transformer]

    named_steps = getattr(numeric_transformer, "named_steps", {})
    candidates.extend(named_steps.values())

    for candidate in candidates:
        statistics = getattr(candidate, "statistics_", None)

        if statistics is not None:
            statistics = np.asarray(statistics, dtype=float)

            if len(statistics) != len(NUMERIC_FEATURES):
                raise ValueError(
                    "Fitted imputer feature count does not match "
                    "the project's numeric feature schema."
                )

            if not np.isfinite(statistics).all():
                raise ValueError(
                    "Fitted numeric imputer contains non-finite "
                    "replacement values."
                )

            return statistics

    raise ValueError(
        "No fitted numeric imputer with statistics_ was found."
    )


def _validate_and_prepare_rows(dataframe):
    """Map columns and separate valid rows from rejected rows."""
    if not isinstance(dataframe, pd.DataFrame):
        raise TypeError("Input must be a pandas DataFrame.")

    if dataframe.empty:
        raise ValueError("The uploaded dataset is empty.")

    if len(dataframe) > MAX_BATCH_ROWS:
        raise ValueError(
            f"Dataset exceeds the maximum of {MAX_BATCH_ROWS} rows."
        )

    if dataframe.columns.duplicated().any():
        duplicates = dataframe.columns[
            dataframe.columns.duplicated()
        ].tolist()
        raise ValueError(
            f"Duplicate input column names detected: {duplicates}"
        )

    original = dataframe.copy().reset_index(drop=True)

    mapping_result = map_sensor_columns(original)
    mapped = mapping_result["dataframe"].copy().reset_index(drop=True)

    missing_features = [
        feature
        for feature in REQUIRED_FEATURES
        if feature not in mapped.columns
    ]

    if missing_features:
        raise ValueError(
            "The uploaded dataset is missing required sensor columns "
            f"after column mapping: {missing_features}"
        )

    for column in NUMERIC_FEATURES:
        mapped[column] = mapped[column].astype(object)

    valid_indices = []
    rejected_records = []
    row_warnings = {}

    for index, row in mapped.iterrows():
        reasons = []
        warnings = []

        for column in NUMERIC_FEATURES:
            value = row[column]

            if _is_missing(value):
                warnings.append(
                    f"{column}: missing; fitted model imputer will be used"
                )
                continue

            converted = pd.to_numeric(
                pd.Series([value]),
                errors="coerce",
            ).iloc[0]

            if pd.isna(converted):
                reasons.append(
                    f"{column}: non-numeric value {value!r}"
                )
                continue

            if not np.isfinite(float(converted)):
                reasons.append(
                    f"{column}: infinite value is not allowed"
                )
                continue

            mapped.at[index, column] = float(converted)

        machine_type = row["Type"]

        if _is_missing(machine_type):
            reasons.append("Type: machine type is missing")
        else:
            normalized_type = str(machine_type).strip().upper()

            if normalized_type not in VALID_MACHINE_TYPES:
                reasons.append(
                    "Type: invalid machine type "
                    f"{machine_type!r}; expected L, M, or H"
                )
            else:
                mapped.at[index, "Type"] = normalized_type

        if reasons:
            rejected_records.append(
                _build_rejected_record(
                    source_record=original.iloc[index].to_dict(),
                    row_number=index + 1,
                    reason="; ".join(reasons),
                    processing_status="REJECTED_VALIDATION",
                    rejection_stage="VALIDATION",
                )
            )
        else:
            valid_indices.append(index)

            if warnings:
                row_warnings[index] = warnings

    valid_dataframe = mapped.iloc[valid_indices].copy()

    if rejected_records:
        rejected_dataframe = pd.DataFrame(rejected_records)
    else:
        rejected_dataframe = _empty_rejected_dataframe(original)

    return (
        original,
        mapped,
        valid_dataframe,
        rejected_dataframe,
        valid_indices,
        row_warnings,
        mapping_result,
    )


def _impute_numeric_values(dataframe, model):
    """Apply only the fitted numeric imputer from the registered model."""
    prepared = dataframe.copy()

    statistics = _get_fitted_numeric_imputer(model)

    for column, replacement in zip(NUMERIC_FEATURES, statistics):
        prepared[column] = pd.to_numeric(
            prepared[column],
            errors="coerce",
        )

        prepared[column] = prepared[column].fillna(float(replacement))

        if not np.isfinite(
            prepared[column].to_numpy(dtype=float)
        ).all():
            raise ValueError(
                f"Non-finite values remain in {column} after imputation."
            )

    prepared["Type"] = (
        prepared["Type"].astype(str).str.strip().str.upper()
    )

    return prepared


def _extract_failure_prediction(prediction):
    """Read a valid binary failure prediction from engine output."""
    if not isinstance(prediction, dict):
        return None

    for key in ("failure_predicted", "failure_prediction"):
        if key not in prediction:
            continue

        value = prediction[key]

        if isinstance(value, (bool, np.bool_)):
            return bool(value)

        if isinstance(value, (int, float, np.integer, np.floating)):
            number = float(value)

            if np.isfinite(number) and number in (0.0, 1.0):
                return bool(int(number))

    return None


def _extract_risk(prediction):
    """Read the final risk label from the integrated prediction."""
    if not isinstance(prediction, dict):
        return "Unavailable"

    for key in ("final_risk", "final_risk_level", "risk_level"):
        value = prediction.get(key)

        if value is not None:
            if isinstance(value, dict):
                value = (
                    value.get("level")
                    or value.get("risk_level")
                    or value.get("category")
                )

            if value is not None:
                return str(value)

    return "Unavailable"


def _has_shap_explanation(prediction):
    """Determine whether the integrated engine produced a SHAP explanation."""
    if not isinstance(prediction, dict):
        return False

    components = prediction.get("prediction_components")

    if isinstance(components, dict):
        if _is_explicit_true(
            components.get("shap_explanation")
        ):
            return True

    shap_status = str(
        prediction.get("shap_explanation_status", "")
    ).strip().lower()

    explanation_status = str(
        prediction.get("explanation_status", "")
    ).strip().lower()

    explanation_method = str(
        prediction.get("explanation_method", "")
    ).strip().lower()

    has_available_status = (
        shap_status == "available"
        or explanation_status == "available"
    )

    uses_shap_method = "shap" in explanation_method

    return has_available_status and uses_shap_method


def _extract_anomaly_counts(prediction):
    """Return (majority_consensus, any_detector_flagged).

    A row is counted in rows_with_anomaly only when a majority of
    available anomaly detectors flag it. Individual detector flags
    are reported separately.
    """
    if not isinstance(prediction, dict):
        return False, False

    assessment = prediction.get("anomaly_assessment")
    results = prediction.get("anomaly_results")

    detector_flags = []

    if isinstance(results, dict):
        for detector_result in results.values():
            if not isinstance(detector_result, dict):
                continue

            flag = detector_result.get("is_anomaly")

            if isinstance(flag, (bool, np.bool_)):
                detector_flags.append(bool(flag))

    flagged_count = sum(detector_flags)
    detector_count = len(detector_flags)

    if detector_count > 0:
        any_flagged = flagged_count > 0
        majority_threshold = detector_count // 2 + 1
        majority_detected = flagged_count >= majority_threshold

        if isinstance(assessment, dict):
            reported_flagged = assessment.get("detectors_flagged")
            reported_total = assessment.get("total_detectors")

            try:
                reported_flagged = int(reported_flagged)
                reported_total = int(reported_total)

                if (
                    reported_total > 0
                    and 0 <= reported_flagged <= reported_total
                ):
                    any_flagged = reported_flagged > 0
                    majority_detected = (
                        reported_flagged >= reported_total // 2 + 1
                    )
            except (TypeError, ValueError, OverflowError):
                pass

        return majority_detected, any_flagged

    if isinstance(assessment, dict):
        try:
            reported_flagged = int(assessment["detectors_flagged"])
            reported_total = int(assessment["total_detectors"])

            if (
                reported_total > 0
                and 0 <= reported_flagged <= reported_total
            ):
                return (
                    reported_flagged >= reported_total // 2 + 1,
                    reported_flagged > 0,
                )
        except (KeyError, TypeError, ValueError, OverflowError):
            pass

    legacy_flag = prediction.get("anomaly_detected")

    if isinstance(legacy_flag, (bool, np.bool_)):
        return bool(legacy_flag), bool(legacy_flag)

    return False, False


def _json_safe(value):
    """Convert pandas/NumPy values into JSON-safe Python values."""
    if isinstance(value, dict):
        return {
            str(key): _json_safe(item)
            for key, item in value.items()
        }

    if isinstance(value, (list, tuple)):
        return [_json_safe(item) for item in value]

    if isinstance(value, np.integer):
        return int(value)

    if isinstance(value, np.floating):
        return float(value) if np.isfinite(value) else None

    if isinstance(value, np.bool_):
        return bool(value)

    if isinstance(value, (pd.Timestamp, datetime)):
        return value.isoformat()

    if value is pd.NA or value is pd.NaT:
        return None

    if isinstance(value, float) and not math.isfinite(value):
        return None

    if isinstance(value, Path):
        return str(value)

    return value


def predict_batch_dataframe(dataframe):
    """Predict valid rows and return predictions, rejected rows, and summary."""
    (
        original,
        mapped,
        valid_dataframe,
        rejected_dataframe,
        valid_indices,
        row_warnings,
        mapping_result,
    ) = _validate_and_prepare_rows(dataframe)

    model, metadata = _load_model()

    compatibility = check_dataset_compatibility(valid_dataframe)

    if not valid_dataframe.empty and not compatibility["compatible"]:
        raise ValueError(
            "Valid rows failed model compatibility checks: "
            + "; ".join(compatibility.get("errors", []))
        )

    prepared_valid = _impute_numeric_values(valid_dataframe, model)

    prediction_records = []
    prediction_errors = []

    for original_index, row in prepared_valid.iterrows():
        sensor_data = {
            feature: row[feature]
            for feature in REQUIRED_FEATURES
        }

        try:
            integrated_result = predict_equipment_condition(
                sensor_data=sensor_data
            )

            if not isinstance(integrated_result, dict):
                raise TypeError(
                    "Integrated engine did not return a dictionary."
                )

            source_record = original.iloc[original_index].to_dict()

            record = dict(source_record)
            record["row_number"] = original_index + 1
            record["processing_status"] = "SUCCESS"
            record["rejection_stage"] = None
            record["rejection_reason"] = None
            record["imputation_warnings"] = row_warnings.get(
                original_index, []
            )
            record.update(integrated_result)

            # Protect the batch processing status from engine output.
            record["processing_status"] = "SUCCESS"
            record["rejection_stage"] = None
            record["rejection_reason"] = None

            prediction_records.append(record)

        except Exception as exc:
            prediction_errors.append(
                _build_rejected_record(
                    source_record=original.iloc[original_index].to_dict(),
                    row_number=original_index + 1,
                    reason=(
                        f"Prediction failed: {type(exc).__name__}: {exc}"
                    ),
                    processing_status="REJECTED_PREDICTION",
                    rejection_stage="PREDICTION",
                )
            )

    if prediction_errors:
        failed_dataframe = pd.DataFrame(prediction_errors)

        rejected_dataframe = pd.concat(
            [rejected_dataframe, failed_dataframe],
            ignore_index=True,
            sort=False,
        )

    # Keep a stable output schema even when every row is accepted.
    for column in REJECTION_COLUMNS:
        if column not in rejected_dataframe.columns:
            rejected_dataframe[column] = pd.Series(dtype="object")

    if "rejection_reason" not in rejected_dataframe.columns:
        rejected_dataframe["rejection_reason"] = pd.Series(dtype="object")

    predictions_dataframe = pd.DataFrame(prediction_records)

    failure_count = 0
    normal_count = 0
    unknown_failure_count = 0
    anomaly_consensus_count = 0
    any_detector_anomaly_count = 0
    risk_distribution = {}
    shap_available_count = 0

    for record in prediction_records:
        failure = _extract_failure_prediction(record)

        if failure is True:
            failure_count += 1
        elif failure is False:
            normal_count += 1
        else:
            unknown_failure_count += 1

        majority_anomaly, any_anomaly = (
            _extract_anomaly_counts(record)
        )

        if majority_anomaly:
            anomaly_consensus_count += 1

        if any_anomaly:
            any_detector_anomaly_count += 1

        risk = _extract_risk(record)
        risk_distribution[risk] = risk_distribution.get(risk, 0) + 1

        if _has_shap_explanation(record):
            shap_available_count += 1

    total_rows = len(original)
    successful_rows = len(prediction_records)
    rejected_rows_count = len(rejected_dataframe)

    validation_rejections = int(
        (
            rejected_dataframe["processing_status"]
            == "REJECTED_VALIDATION"
        ).sum()
    )

    prediction_rejections = int(
        (
            rejected_dataframe["processing_status"]
            == "REJECTED_PREDICTION"
        ).sum()
    )

    summary = {
        "status": (
            "COMPLETED"
            if successful_rows > 0
            else "NO_ROWS_PREDICTED"
        ),
        "model_name": metadata.get("model_name", "XGBoost"),
        "total_rows": total_rows,
        "successful_predictions": successful_rows,
        "rejected_rows": rejected_rows_count,
        "validation_rejections": validation_rejections,
        "prediction_rejections": prediction_rejections,
        "failure_predictions": failure_count,
        "normal_predictions": normal_count,
        "unknown_failure_results": unknown_failure_count,
        "rows_with_anomaly": anomaly_consensus_count,
        "rows_with_any_anomaly_detector": any_detector_anomaly_count,
        "risk_distribution": risk_distribution,
        "shap_explanations_available": shap_available_count,
        "numeric_missing_value_policy": (
            "Imputed using the fitted registered model imputer"
        ),
        "machine_type_policy": (
            "Missing or invalid machine types are rejected"
        ),
        "required_features": REQUIRED_FEATURES,
        "numeric_features": NUMERIC_FEATURES,
        "column_mapping": mapping_result["mapping"],
        "unmatched_columns": mapping_result["unmatched_columns"],
        "compatibility_warnings": (
            compatibility.get("warnings", [])
        ),
        "model_threshold": metadata.get("threshold"),
        "prediction_engine": "integrated_engine",
        "shap_is_per_row": (
            successful_rows > 0
            and shap_available_count == successful_rows
        ),
        "note": (
            "SHAP count uses explicit SHAP component or available "
            "SHAP explanation status and method. rows_with_anomaly "
            "requires majority detector consensus; "
            "rows_with_any_anomaly_detector counts any detector flag. "
            "Failure metrics are not calculated from uploaded labels. "
            "Predictions are not ground-truth validation."
        ),
    }

    return {
        "predictions": predictions_dataframe,
        "rejected_rows": rejected_dataframe,
        "summary": _json_safe(summary),
    }


def predict_batch_file(input_file, output_dir=None):
    """Load a supported file, process it, and save batch output files."""
    input_path = Path(input_file)

    if not input_path.is_file():
        raise FileNotFoundError(
            f"Input file does not exist: {input_path}"
        )

    dataframe = load_machine_data(input_path)
    result = predict_batch_dataframe(dataframe)

    destination = (
        Path(output_dir)
        if output_dir is not None
        else DEFAULT_OUTPUT_DIR
    )
    destination.mkdir(parents=True, exist_ok=True)

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    stem = input_path.stem

    predictions_path = (
        destination / f"{stem}_predictions_{timestamp}.csv"
    )
    rejected_path = (
        destination / f"{stem}_rejected_rows_{timestamp}.csv"
    )
    summary_path = (
        destination / f"{stem}_batch_summary_{timestamp}.json"
    )

    result["predictions"].to_csv(
        predictions_path,
        index=False,
        encoding="utf-8-sig",
    )

    result["rejected_rows"].to_csv(
        rejected_path,
        index=False,
        encoding="utf-8-sig",
    )

    result["summary"]["input_file"] = str(input_path.resolve())
    result["summary"]["predictions_file"] = str(
        predictions_path.resolve()
    )
    result["summary"]["rejected_rows_file"] = str(
        rejected_path.resolve()
    )

    with summary_path.open("w", encoding="utf-8") as file:
        json.dump(
            _json_safe(result["summary"]),
            file,
            indent=4,
            ensure_ascii=False,
        )

    result["summary"]["summary_file"] = str(
        summary_path.resolve()
    )

    return {
        **result,
        "files": {
            "predictions": predictions_path,
            "rejected_rows": rejected_path,
            "summary": summary_path,
        },
    }


def main():
    parser = argparse.ArgumentParser(
        description="Run row-wise industrial sensor batch prediction."
    )
    parser.add_argument(
        "input_file",
        help="Path to a supported CSV or Excel sensor dataset.",
    )
    parser.add_argument(
        "--output-dir",
        default=None,
        help="Optional directory for generated batch reports.",
    )

    args = parser.parse_args()

    result = predict_batch_file(
        args.input_file,
        output_dir=args.output_dir,
    )

    print("\nBATCH PREDICTION COMPLETED")
    print("--------------------------")
    print(json.dumps(result["summary"], indent=4))
    print("\nOUTPUT FILES")
    print("Predictions:", result["files"]["predictions"])
    print("Rejected rows:", result["files"]["rejected_rows"])
    print("Summary:", result["files"]["summary"])


if __name__ == "__main__":
    main()
